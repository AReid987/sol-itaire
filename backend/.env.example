# Server Configuration
PORT=3001
NODE_ENV=production

# Solana Configuration
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Token Addresses (Devnet)
GAMING_TOKEN_ADDRESS=PLACEHOLDER_GAMING_TOKEN_ADDRESS
MEMECOIN_ADDRESS=PLACEHOLDER_MEMECOIN_ADDRESS

# Frontend URL (for CORS)
FRONTEND_URL=https://web-jd43nyiq4-aigency0.vercel.app

# Database
DATABASE_URL=PLACEHOLDER_POSTGRESQL_URL

# MongoDB Configuration (optional)
MONGODB_URI=PLACEHOLDER_MONGODB_URI

# Solana Wallet (optional - base64-encoded keypair JSON array)
SOLANA_WALLET_KEYPAIR=PLACEHOLDER_KEYPAIR_ARRAY

# Token Mint Addresses (Devnet)
GAMING_TOKEN_MINT_ADDRESS=PLACEHOLDER_GAMING_TOKEN_MINT
MEMECOIN_MINT_ADDRESS=PLACEHOLDER_MEMECOIN_MINT

# Security
JWT_SECRET=PLACEHOLDER_JWT_SECRET
