# Server Configuration
PORT=3001
NODE_ENV=production

# Solana Configuration
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Token Addresses (Devnet)
GAMING_TOKEN_ADDRESS=your-gaming-token-mint-address
MEMECOIN_ADDRESS=your-memecoin-mint-address

# Frontend URL (for CORS)
FRONTEND_URL=https://web-jd43nyiq4-aigency0.vercel.app

# Database
DATABASE_URL=postgresql://...

# MongoDB Configuration (optional)
MONGODB_URI=mongodb://localhost:27017/solitaire

# Solana Wallet (optional - base64-encoded keypair JSON array)
SOLANA_WALLET_KEYPAIR=[your-keypair-json-array-here]

# Token Mint Addresses (Devnet)
GAMING_TOKEN_MINT_ADDRESS=your-gaming-token-mint-address
MEMECOIN_MINT_ADDRESS=your-memecoin-mint-address

# Security
JWT_SECRET=your-secret-key-here
